#version 430

#define CAPS 1
#define COMP_ARROW 0

#define RM_EPSILON 0.003
#define RM_MAX_ITERATIONS 30
#define RM_FDG_DELTA 0.05
#define RM_SHOW_BOUNDING 0


#define M_PI 3.14159265359

//***** begin interface of view.glsl ***********************************
mat4 get_modelview_matrix();
mat4 get_projection_matrix();
mat4 get_modelview_projection_matrix();
mat4 get_inverse_modelview_matrix();
mat4 get_inverse_modelview_projection_matrix();
mat3 get_normal_matrix();
mat3 get_inverse_normal_matrix();
//***** end interface of view.glsl ***********************************

//***** begin interface of fragment.glfs ***********************************
uniform float gamma = 2.2;
void finish_fragment(vec4 color);
void finish_fragment(vec4 color, float depth);
//***** end interface of fragment.glfs ***********************************

//***** begin interface of surface.glsl ***********************************
vec4 compute_reflected_appearance(vec3 position_eye, vec3 normal_eye, vec4 color, int side);
//***** end interface of surface.glsl ***********************************


in vec3 position;
in flat vec4 start_fs;
in flat vec4 end_fs;
in flat vec3 normal_fs;
in flat vec3 binormal_fs;
in flat vec4 color_start_fs;
in flat vec4 color_end_fs;
in flat mat4 cone_transform_fs;
in flat mat4 inv_cone_transform_fs;

layout (binding = 0) uniform sampler2D color_maps_tex;
uniform vec4 glyph_cc_param;
uniform float radius_scale;

layout(location = 1) out vec4 frag_position;
layout(location = 2) out vec3 frag_normal;

float dot2(vec3 v) {
	return dot(v, v);
}

// clamp value v to range [r.x,r.y] and remap to [r.z,r.w]
float clamp_remap(float v, vec4 r) {
	v = clamp(v, r.x, r.y);
	float t = 0.0;
	if(abs(r.x - r.y) > 0.00001)
		t = (v - r.x) / (r.y - r.x);
	return mix(r.z, r.w, t);
}

vec3 map_to_color(float v, int color_map_idx) {
	vec2 ts = textureSize(color_maps_tex, 0);
	float half_step = 0.5 * (1.0 / ts.y);
	float map_coord = float(color_map_idx) / ts.y + half_step;
	return pow(texture(color_maps_tex, vec2(v, map_coord)).rgb, vec3(2.2));
}

// https://www.shadertoy.com/view/llcfRf
float intersect_cone(in vec3 org, in vec3 dir, in vec3 pa, in vec3 pb, in float ra, in float rb, out vec3 normal, out float l) {

	vec3 ba = pb - pa;
    vec3 oa = org - pa;
    vec3 ob = org - pb;
    
    float m0 = dot(ba, ba);
    float m1 = dot(oa, ba);
    float m2 = dot(ob, ba); 
    float m3 = dot(dir, ba);

#if CAPS == 1
    //caps
    if(m1 < 0.0) {
		if(dot2(oa*m3-dir*m1) < (ra*ra*m3*m3)) {
			l = 0.0;
			normal = -ba*inversesqrt(m0);
			return -m1/m3;
		}
	} else if(m2 > 0.0) {
		if(dot2(ob*m3-dir*m2) < (rb*rb*m3*m3)) {
			l = 1.0;
			normal = +ba*inversesqrt(m0);
			return -m2/m3;
		}
	}
#endif
    
    // body
    float m4 = dot(dir, oa);
    float m5 = dot(oa, oa);
    float rr = ra - rb;
    float hy = m0 + rr*rr;
    
    float k2 = m0*m0    - m3*m3*hy;
    float k1 = m0*m0*m4 - m1*m3*hy + m0*ra*(rr*m3*1.0        );
    float k0 = m0*m0*m5 - m1*m1*hy + m0*ra*(rr*m1*2.0 - m0*ra);
    
    float h = k1*k1 - k2*k0;
    if(h < 0.0)
		return -1e20;

    float t = (-k1-sqrt(h))/k2;

    float y = m1 + t*m3;
    if(y > 0.0 && y < m0) {
		l = y / m0;
        normal = normalize(m0*(m0*(oa+t*dir)+rr*ba*ra)-ba*hy*y);
		return t;
    }
    
    return -1e20;
}


float op_union( float d1, float d2 )
{
    return min(d1,d2);
}

float sd_cone(vec3 pos, vec2 c, float height )
{
  float q = length(pos.yz);
  return max(dot(c.xy, vec2(q, pos.x)),-height-pos.x);
}

vec3 normal_cone(vec3 pos, vec2 c, float height)
{
	if(pos.x>=0.0)
		return vec3(-1.0, 0.0, 0.0);
	return normalize(vec3(-pos.x+c.y, pos.yz));
}

float sd_cylinder(vec3 pos, float height, float radius )
{
  vec2 d = abs(vec2(length(pos.yz),pos.x)) - vec2(radius,height);
  return min(max(d.x,d.y),0.0) + length(max(d,0.0));
}

vec3 ray_march(in out vec3 hit_pos, in vec3 dir, in vec3 start, in vec3 end, in float radius_start, in float radius_end, out vec3 normal_glyph, in out float lambda)
{	
	float height = length(end - start);
	float mid_height = 0.5 * height;

	//should now be in unit cube space
	vec3 hit_pos_glyph = (inv_cone_transform_fs * vec4(hit_pos, 1.0)).xyz;
	vec3 dir_glyph = normalize((inv_cone_transform_fs * vec4(dir, 0.0)).xyz);

	//it all three directions are scaled, so the radius needs to be scaled down as well.
	vec2 cone_slope = normalize(vec2(mid_height, radius_start));
	int i = 0;
	//Dist is 0 at the beginning, because we start at the general sphere surface coming from the ray cast result.
	float dist = 0.0;
	while(i < RM_MAX_ITERATIONS)
	{
		dist = op_union(sd_cone(hit_pos_glyph - vec3(mid_height, 0.0, 0.0), cone_slope, mid_height), sd_cylinder(hit_pos_glyph + vec3(mid_height, 0.0, 0.0), mid_height, 0.5*radius_start));
		lambda += dist;
		// we hit -> calculate normal using finite difference gradient
		if(abs(dist) <= RM_EPSILON)
		{	
			hit_pos = (cone_transform_fs * vec4(hit_pos_glyph + vec3(mid_height, 0.0, 0.0), 1.0)).xyz;
			normal_glyph = normalize((inv_cone_transform_fs * vec4(normal_cone(hit_pos_glyph, cone_slope, mid_height), 0.0)).xyz);			
			//return normal_cone(hit_pos_glyph, cone_slope, mid_height);
			return map_to_color(clamp_remap(color_start_fs.x, glyph_cc_param), int(color_start_fs.y));
		}
		hit_pos_glyph += dir_glyph * dist;
		i++;
	}

	#if RM_SHOW_BOUNDING == 0
		discard;
	#else
		return vec3(1.0, 0.0, 0.0);
	#endif
}

void main()
{
	// Original
	//vec3 org = vec3(0.0);
	//vec3 dir = normalize(position);
	//vec3 org = (get_inverse_modelview_matrix() * vec4(vec3(0.0), 1.0)).xyz;
	
	// Intersection is performed in object space.
	// The eye position is at the origin and this fragment is located at "position"
	// By moving the eye position closer to the fragment position we can improve the numeric accuracy of the resulting
	// transformed vectors and directions.
	vec3 org = (get_inverse_modelview_matrix() * vec4(0.98*position, 1.0)).xyz;
	vec3 dir = normalize((get_inverse_modelview_matrix() * vec4(normalize(position), 0.0)).xyz);
	
	vec3 normal;
	float l;

	//THESIS2: workaround to be able to just render a cone OR an arrow head
	#if COMP_ARROW == 1
	float t = intersect_cone(org, dir, start_fs.xyz, end_fs.xyz, color_start_fs.w * radius_scale, color_end_fs.w * radius_scale, normal, l);
	#else
	float t = intersect_cone(org, dir, start_fs.xyz, end_fs.xyz, start_fs.w, end_fs.w, normal, l);
	#endif

	vec3 hit_pos = org + t * dir;
	if(t >= 0.0)
	{
		vec4 color;	
		#if COMP_ARROW == 1
			color = vec4(ray_march(hit_pos, dir, start_fs.xyz, end_fs.xyz, start_fs.w, end_fs.w, normal, t), 1.0);
		#else
			color = vec4(map_to_color(clamp_remap(color_start_fs.x, glyph_cc_param), int(color_start_fs.y)), 1.0);
		#endif

		vec3 hit_pos_eye = (get_modelview_matrix() * vec4(hit_pos, 1.0)).xyz;
		vec3 normal_eye = normalize(get_normal_matrix() * normal);
	
		vec4 v_eye = vec4(hit_pos_eye, 1.0);
		vec4 depth = get_projection_matrix() * v_eye;
		
		finish_fragment(vec4(compute_reflected_appearance(hit_pos_eye, normal_eye, vec4(color.xyz, 1.0), 1).rgb, color.a));
		frag_position = vec4(hit_pos_eye, 1.0);
		frag_normal = normal_eye;
		gl_FragDepth = 0.5*(depth.z / depth.w) + 0.5;
	} else {
		discard;
	}
}