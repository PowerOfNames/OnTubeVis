// code for drawing digits from https://www.shadertoy.com/view/lsXXzN
// adjusted to own needs
float segment(vec2 uv, bool on) {
	return on ? (1.0 - smoothstep(0.08, 0.09 + float(on)*0.02, abs(uv.x))) *
			    (1.0 - smoothstep(0.46, 0.47 + float(on)*0.02, abs(uv.y) + abs(uv.x)))
		        : 0.0;
}

float digit(vec2 uv, uint num) {
	float seg = 0.0;
    seg += segment(uv.yx + vec2(-1.0, +0.0), num!=1 && num!=4                    );
	seg += segment(uv.xy + vec2(-0.5, -0.5), num!=1 && num!=2 && num!=3 && num!=7);
	seg += segment(uv.xy + vec2(+0.5, -0.5), num!=5 && num!=6                    );
   	seg += segment(uv.yx + vec2(+0.0, +0.0), num!=0 && num!=1 && num!=7          );
	seg += segment(uv.xy + vec2(-0.5, +0.5), num==0 || num==2 || num==6 || num==8);
	seg += segment(uv.xy + vec2(+0.5, +0.5), num!=2                              );
    seg += segment(uv.yx + vec2(+1.0, +0.0), num!=1 && num!=4 && num!=7          );
	return seg;
}

/* To show hidden glyphs only as a ring:
	if(debug_info > 0) {
		alpha_fac = 0.5; // make glyph half transparent
		dist = op_onion(dist + 0.05, 0.05); // draw outline of glyph (keeps original size)
	}
*/

vec4 splat_generic_glyph(in uint debug_info, in float dist, in vec3 glyph_color, in float outline, out float non_outline_factor) {
	
	// debug only
	// show otherwise not drawn glyphs
	float alpha_fac = 1.0;
	if(debug_info > 0)
		alpha_fac = 0.5; // make glyph half transparent

	// >> non-debuig implementation
	// pre-filter the SDF for AA
#if OUTLINE_INWARDS == 0
	vec2 dist2 = vec2(dist, dist - outline);
	#else
	vec2 dist2 = vec2(dist + outline, dist);
#endif
	const vec2 antialias_width = antialias_radius*fwidth(dist2);
	vec2 alpha = 1.0 - smoothstep(-antialias_width, antialias_width, dist2);
	alpha *= alpha_fac;
	if(outline < 0.01) {
		non_outline_factor = 1;
		return vec4(glyph_color, alpha.x);
	} else {
		vec4 color = vec4(vec3(0.0), alpha.y);
		non_outline_factor = 1.0-(alpha.y*(1.0-alpha.x));
		return mix(color, vec4(glyph_color, 1.0), alpha.x);
	}

	//return mix(glyph_color, color, smoothstep(-antialias_width, antialias_width, dist));
	// <<
}

//THESIS:
// p			= input point
// radiusAxis	= the eigenvalue,
// angleAxis	= the angle of rotation (TODO: get the mapping correct)
// result should be an ellipsoid of dimensions radiusX, Y, Z, rotated around the Axis by their respective angles -> Z is potentially moved out
// of this function and instead used to get a shading (color) gradient in the color/splat function AND for the Depth value, potentially as well.
// Final result should be a little window inside the tube, showing an ellipoid. The window should be billboarded towards the camera -> moving around the
// tube should make it possible to view the ellipsoid from all sides (As first step and for testing purposes, before 3D glyphs get implemented.

//Base ellipsoid SDF from https://iquilezles.org/articles/distfunctions
//float sdTensorEllipsoid(in vec3 p, in vec3 radii)
//{
//    float k0 = length(p/radii);
//    float k1 = length(p/(radii*radii));
//    return k0*(k0-1.0)/k1;
//}



//from https://iquilezles.org/articles/ellipsedist/ 
// 2D
float sd_ellipsoidTensor2D(in vec2 p, in float radiusX, in float radiusY, in float radiusZ, in float angleX, in float angleY, in float angleZ)
{
	vec2 ab = vec2(radiusX, radiusY);
	// symmetry
    p = abs( p );
    
    // determine in/out and initial omega value
    bool s = dot(p/ab,p/ab)>1.0;
    float w = s ? atan(p.y*ab.x, p.x*ab.y) : 
                  ((ab.x*(p.x-ab.x)<ab.y*(p.y-ab.y))? 1.5707963 : 0.0);
    
    // find root with Newton solver
    for( int i=0; i<5; i++ )
    {
        vec2 cs = vec2(cos(w),sin(w));
        vec2 u = ab*vec2( cs.x,cs.y);
        vec2 v = ab*vec2(-cs.y,cs.x);
        w = w + dot(p-u,v)/(dot(p-u,u)+dot(v,v));
    }
    
    // compute final point and distance
    return length(p-ab*vec2(cos(w),sin(w))) * (s?1.0:-1.0);
}

float sd_sphere(in vec3 ray_pos_glyph, in float radius)
{
	return length(ray_pos_glyph) - radius;
}

//phi for yaw,
//theta for pitch,
//psi for yaw
mat3 reconstructRotMat(in float yaw, in float pitch, in float roll)
{
	float sPhi = sin(yaw);
	float cPhi = cos(yaw);
	float sTheta = sin(pitch);
	float cTheta = cos(pitch);
	float sPsi = sin(roll);
	float cPsi = cos(roll);

	return mat3(cTheta*cPsi, cPsi*sTheta*sPhi-cPhi*sPsi, cPhi*cPsi*sTheta+sTheta*sPsi,
				cTheta*sPsi, cPhi*cPsi+sTheta*sPhi*sPsi, cPhi*sTheta*sPsi-cPsi*sTheta,
				-sTheta, cTheta*sPhi, cTheta*cPhi);
}

//THESIS TODO:	Cones need much more iterations then "round shaped" due to their straight edge, which increases step count significantly when theta
//				dot(cone_up, view_vec) -> 1 (looking down the cone)
float sd_cone(in vec3 ray_pos_glyph, in float height, in float pitch, in float yaw)
{
	const float pi_over_three = M_PI*0.45;

	mat3 transform = reconstructRotMat(pitch, yaw, 0);
	vec3 posTrans = transform*vec3(ray_pos_glyph.x, ray_pos_glyph.y - 0.5*height, ray_pos_glyph.z);

	float s = sin(pi_over_three);
	float c = cos(pi_over_three);
	float q = length(posTrans.xz);
	return max(dot(vec2(s,c), vec2(q, posTrans.y)), -height - posTrans.y);
}

// transform of p using eigen vector transform matrix:
// mat3 transform = mat3(eigen1.xyz, eigen2.xyz, eigen3.xyz);
// actual p = transpose(transform) * (rayPos - ellipsoidPos);
// Now, rayPos is just a UV coord and ellipsoid Pos is basically the center of the 2D glyph rectangle. I just need to do a 2D ellipsoid check, using two 
// rotations to get a spalled version of the 3D version and then using the left out rotation as a mapping parameter to gradient shade the color or better,
// simulate the surface light by calculating normals.
// anglex -> yaw in x/z-plane; 
// angley -> pitch in y/z-plane
// anglez -> roll in x/y plane
//THESIS TODO:	Transformation to the ray_pos_glyph MUST happen BEFORE ray_marching happens. Otherwise the whole Transformation-reconstruction+transformation happens
//				at every step+Normalcalc as well. -> It'S even possible to skew space using the radii -> use Sphere SDF instead of Ellipse (but need to do the inverse afterwards, prob.)
float sd_ellipsoid3x3tensor(in vec3 ray_pos_glyph, in float radiusX, in float radiusY, in float radiusZ, in float angleX, in float angleY, in float angleZ) 
{
	vec3 radii = vec3(radiusX, radiusY, radiusZ);
	mat3 transform = reconstructRotMat(angleX, angleY, angleZ);
	vec3 posTrans = transform*ray_pos_glyph;

	float k0 = length(posTrans/radii);
    float k1 = length(posTrans/(radii*radii));
    return k0*(k0-1.0)/k1;
}



vec4 skewedSmoothStep(vec4 colorStart, vec4 colorEnd, float x, float skew) {
    float t = pow(x, skew); // Apply skew to shift the slope
    t = t * (3.0 - 2.0 * t); // Smoothstep curve
	return mix(colorStart, colorEnd, t);
}

vec4 cheapSmoothStep(vec4 colorStart, vec4 colorEnd, float x, float bias) {
    float t = mix(0.0, x, bias); // Apply bias to shift slope
    t = t * t * (3.0 - 2.0 * t); // Smoothstep curve
	return mix(colorStart, colorEnd, t);
}

struct ray_march_result
{
	bool hit;
	vec3 pos_eye, normal_eye;

	//Debugging
	vec3 debug_color;
	bool isNext;
	bool isPrev;
};

vec4 splat_generic_glyph_3D(in uint debug_info, in vec2 uv, in ray_march_result rmr, in float tube_radius, inout float depth, in vec3 glyph_color, in float windowedSize)
{
	if(abs(uv.y) <= windowedSize)
	{		
		if(rmr.hit)
		{
			if(rmr.isNext)
				return vec4(glyph_color * vec3(1.0, 0.0, 0.0), 1.0);

			if(rmr.isPrev)
				return vec4(glyph_color * vec3(0.0, 1.0, 0.0), 1.0);
			//THESIS TODO: 
			//vec4 hit_pos_clip = get_projection_matrix() * vec4(rmr.pos_eye, 1.0);
			//depth = ((hit_pos_clip.z / hit_pos_clip.w) + 1.0) / 2.0;
			return vec4(glyph_color, 1.0);
		}

		//THESIS TODO: render tube backside?
		//return vec4(1.0, 0.5, 1.0, 1.0);	
		//return vec4(rmr.debug_color, 1.0);
		return vec4(0.0);
	}
	return vec4(0.0);
}

