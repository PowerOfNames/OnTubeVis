vec3 hash31(float p)
{
   vec3 p3 = fract(vec3(p) * vec3(.1031, .1030, .0973));
   p3 += dot(p3, p3.yzx+33.33);
   return fract((p3.xxy+p3.yzz)*p3.zyx); 
}

//Calculates the dotproduct between the projection of a vector onto the plane spanned by two unit vectors #8up and right), and the second unit vector (right)
float CalcVectorPlaneProjDot(in vec3 vector, in vec3 planeUp, in vec3 planeRight, in float earlyOutThreshold)
{
	float dotVecUp = dot(vector, planeUp);
	//Early out if looking straight down (near parallel to normal)
	if(abs(dotVecUp) >= earlyOutThreshold)
		return 0.0;

	vec3 projection = vector - planeUp * dotVecUp;
	vec3 projNormalized = normalize(projection);
	return dot(projNormalized, planeRight);
	//return acos(clamp(c, -1, 1));
}

//Calculates the glyph position in tube space
vec3 CalcGlyphCenterPosTube()
{
	return vec3(1.0);
}

void main()
{
	const uint num_subpixels = holographic_raycast ? 3 : 1;
	const float subpxl_width = 1./framebuf_width;
	const float pxl_width = 1./viewport_width;
	const float intra_fbtexel_offset = subpxl_width*.125f;
	const uint fbpxl = uint((texcoord_fs.x) * framebuf_width);
	const float pxl = float(uint(fbpxl/num_subpixels));
	const uint subpxl = fbpxl % 3;


	/////////////////////////////////////////////
	// BEGIN - holography loop
	float frag_depth = 1;
	for (uint subp=0; subp<num_subpixels; subp++) {	
	
	const vec2 fb_uv = vec2(/*(holographic_raycast ? pxl*subpxl_width : */pxl*pxl_width + subp*subpxl_width + intra_fbtexel_offset,
		texcoord_fs.y);

	uvec4 albedo_texcoord_seg = texture(albedo_tex, fb_uv);
	vec3 color = unpackUnorm4x8(albedo_texcoord_seg.x).rgb;
	vec2 texcoord = vec2(uintBitsToFloat(albedo_texcoord_seg.y), uintBitsToFloat(albedo_texcoord_seg.z));
	int segment_id = int(albedo_texcoord_seg.w);

	uvec4 pos_eye_radius = texture(position_tex, fb_uv);
	vec3 pos_eye = vec3(uintBitsToFloat(pos_eye_radius.x), uintBitsToFloat(pos_eye_radius.y), uintBitsToFloat(pos_eye_radius.z));
	float tube_radius = uintBitsToFloat(pos_eye_radius.w);

	vec3 normal_eye = texture(normal_tex, fb_uv).rgb;
	vec3 tangent_eye = texture(tangent_tex, fb_uv).xyz;
	vec3 bitangent_eye = vec3(1.0);
	float depth = texture(depth_tex, fb_uv).r;
	float specular_factor = 1;

	vec4 subp_color;
	if(depth == 1.0) {
		// TODO: these fragments are never drawn to the screen (because depth is one)
		subp_color = vec4(vec3(0.0), 1.0);
	} else {
		vec2 uv = texcoord;

		// The texture coordinate v (around the tube) lies in [0,1] at the front side (camera facing side) of the tube,
		// with 0 at the top and 1 at the bottom of the visible part of the tube (if the bitangent is pointing up in screen space).
		// The back side of the tube is parameterized in the same way, but we are only interested in the front side anyway.
		
		// Move the origin (0,0) to the center of the front side and scale the v coordinate to [-1,1]
		uv.t = 2.0 * uv.t - 1.0;

		// Correct the perspective distortion caused by the curved tube surface by rescaling the v coordinate around the tube.
		if(use_curvature_correction)
			uv.t = sin(0.5*M_PI*uv.t);

		//subp_color = vec4(uv.s, uv.t, 0.0, 1.0);

		// glyph layer 0
#if L0_VISIBLE > 0 && L0_MAPPED_ATTRIB_COUNT > 0
		{
			closest_glyphs_info closest;
			vec2 glyphuv = uv;
			if (get_closest_samples0(segment_id, glyphuv.s, closest)) {
				glyph_desc0 glyph = glyphs0[closest.id];
				bool closest_prev = closest.dp <= closest.dn;
				glyphuv = vec2(
					(closest_prev ? closest.dp : -closest.dn)
					* length_scale, // <-- ToDo: replace with automatic uv re-projection method
					glyphuv.t
				);
				
			//THESIS:
			ray_march_result rmr;
		#if GLYPH_TYPE_IS_3D == 1
				{
					rmr.isPrev = false;
					rmr.isNext = false;
					rmr.debug_color = vec3((closest.id % 2) * 0.7, 0.0, 0.0);

					vec3 glyph_center_tube = texture(glyph_center_tex, fb_uv).xyz;

					// ----- Manual radius calculation -----
					// TODO: for steep angles (bitangents near parallel to screen plane) we dont want to get the 3D glyphs but keep 2D to reduce artifacts
					// TODO: only perfomr these calculations without "windowed" size
					//Tube radius
					bitangent_eye = normalize(cross(normal_eye, tangent_eye));
					//vec4 bitangent_clip = get_projection_matrix() * vec4(bitangent_eye, 0.0);
					// TODO: make this depth dependent -> farther away requires smaller step size
					//float uv_s_direction = glyphuv.s < 0.5 ? -1.0 : 1.0;
					//float uv_t_direction = glyphuv.t < 0 ? -1.0 : 1.0;					
					
					//float scaled_depth = uv_displacement_factor*(1.0-depth);
					//const vec2 uv_displaced = fb_uv + bitangent_clip.xy * scaled_depth * uv_t_direction /* subpxl_width*/;
					//vec3 normal_at_displacement = texture(normal_tex, uv_displaced).xyz;
					//tubeRadius = calcTubeRadius(normalize(get_inverse_normal_matrix() * normal_eye), normalize(get_inverse_normal_matrix() * normal_at_displacement), length(uv_displaced - fb_uv));
					// ----- Manual radius calculation ----- END					


					//TODO: Make more precise (fragmented at cases where the step in tangent direction leaves the correct/current tube segment)
					//TODO: Check if transformation is neccessary (I assumed it was, because it should increase precision (tube-space >> eye), 
					//				but all these eye->tube->eye transformations are expensive
					vec3 pos_tube = (get_inverse_modelview_matrix() * vec4(pos_eye, 1.0)).xyz;
					vec3 tangent_tube = normalize(get_inverse_normal_matrix() * tangent_eye);
						
					//Get to center of glyph
					vec3 center_frame_pos_tube = pos_tube + closest.d * (closest_prev ? -tangent_tube : tangent_tube);
					vec3 center_frame_pos_eye = (get_modelview_matrix() * vec4(center_frame_pos_tube, 1.0)).xyz;
					vec4 center_frame_pos_clip = get_projection_matrix() * vec4(center_frame_pos_eye, 1.0);
					vec3 center_frame_pos_ndc = center_frame_pos_clip.xyz / center_frame_pos_clip.w;
					vec2 center_frame_pos_screen = vec2((center_frame_pos_ndc.x + 1.0) / 2.0 , (center_frame_pos_ndc.y + 1.0) / 2.0);
						
					vec3 center_frame_normal_eye = texture(normal_tex, center_frame_pos_screen).xyz;
					uvec4 center_frame_albedo = texture(albedo_tex, center_frame_pos_screen);
					int center_frame_hit_segment_id = int(center_frame_albedo.w);
					//Caution: the tube radius is just an approximation because we work with the radius at pos_tube (current pixel), not the radius at the center_frame pos
					// -> if the radii of spheres capping the cone are very different, therefore offsetting the glyph
					
					vec3 center_frame_center_tube = texture(glyph_center_tex, center_frame_pos_screen).xyz;
					//vec3 center_frame_center_tube = center_frame_pos_tube - normalize(get_inverse_normal_matrix() * center_frame_normal_eye) * tube_radius;
					//vec3 glyph_pos_eye = (get_modelview_matrix() * vec4(center_frame_center_tube, 1.0)).xyz;

					vec3 ray_dir_glyph = normalize(get_inverse_normal_matrix() * pos_eye);
					vec3 ray_pos_glyph = pos_tube - center_frame_center_tube;		
					rmr.hit = false;
					float dist = 1000.0;
					int i = 0;

					//Check if screen pixel lies on tube surface and if its the same or neighbouring segment ID
					if(center_frame_normal_eye != vec3(0.0) && abs(center_frame_hit_segment_id-segment_id) <= 1 )
					{
						while(i < glyph_rm.max_iterations)
						{
							dist = GLYPH_SDF_DEFINITION;
							if(dist < glyph_rm.hit_epsilon)
							{
								rmr.pos_eye = (get_modelview_matrix() * vec4(ray_pos_glyph + center_frame_center_tube, 1.0)).xyz;
								rmr.hit = true;
								break;
							}
							ray_pos_glyph = ray_pos_glyph + ray_dir_glyph * dist;
							i++;
						}					
					}						

					if(glyph_rm.handle_neighbour_tex_clipping && !rmr.hit)
					{
						//	If the angle between the view vector and the tangent are above a threshold AND the the view vector is looking along the trajectory,
						//	check the next glyph instead, as the view ray then traverses
						//	that as well, without a chance of hitting the first glyph
						float dotPos_Tang = CalcVectorPlaneProjDot(normalize(pos_eye), normal_eye, tangent_eye, 1.0/*glyph_rm.tan_bitan_thresholds.x*/);
						//TODO: Replace 0 with a value that is near the edge of the glyph with respect to the view direction, and do this before the first
						//		Raycast -> no need to do Ray-Glyph intersection tests if the view angle is flat enough to never hit the actual glyph, but always the next
						//IDEA: Use Prof. Gumholds Silhouettes, but not in this shader -> Create a Geometryshader for that and check if the performance is still
						//		viable or even better (geometry shader creation, usage and composition is expensive as well to create all the billboards, but should reduce
						//		FS cost significantly around the Ray-Casting parts
						if(dotPos_Tang >= 0)
						{
							int nextGlyphID = closest.id + 1 == glyphs0.length() ? closest.id : closest.id + 1;
							glyph_desc0 nextGlyph = glyphs0[nextGlyphID];

							float ds = nextGlyph.s - glyph.s;
							vec3 behindBorder_pos_tube = center_frame_pos_tube + ds * 1.01 * tangent_tube;
							vec3 behindBorder_pos_eye = (get_modelview_matrix() * vec4(behindBorder_pos_tube, 1.0)).xyz;
							vec4 behindBorder_pos_clip = get_projection_matrix() * vec4(behindBorder_pos_eye, 1.0);
							vec3 behindBorder_pos_ndc = behindBorder_pos_clip.xyz / behindBorder_pos_clip.w;
							vec2 behindBorder_pos_screen = vec2((behindBorder_pos_ndc.x + 1.0) / 2.0 , (behindBorder_pos_ndc.y + 1.0) / 2.0);							

							vec3 nextGlpyh_tangent_eye = texture(tangent_tex, behindBorder_pos_screen).xyz;
							vec3 nextGlyph_tangent_tube = normalize(get_inverse_normal_matrix() * nextGlpyh_tangent_eye);

							//take 50%s in tangent direction of actual glyph to get to border, then 0.5*s in tangent direction of next glyph to get to center of next glyph
							center_frame_pos_tube = center_frame_pos_tube + 0.5*ds*tangent_tube + 0.5*ds*nextGlyph_tangent_tube;
							
							//Do the same as before, just now for the center of the next glyph
							center_frame_pos_eye = (get_modelview_matrix() * vec4(center_frame_pos_tube, 1.0)).xyz;
							center_frame_pos_clip = get_projection_matrix() * vec4(center_frame_pos_eye, 1.0);
							center_frame_pos_ndc = center_frame_pos_clip.xyz / center_frame_pos_clip.w;
							center_frame_pos_screen = vec2((center_frame_pos_ndc.x + 1.0) / 2.0 , (center_frame_pos_ndc.y + 1.0) / 2.0);

							center_frame_normal_eye = texture(normal_tex, center_frame_pos_screen).rgb;

							center_frame_albedo = texture(albedo_tex, center_frame_pos_screen);
							center_frame_hit_segment_id = int(center_frame_albedo.w);

							uvec4 nextGlpyh_pos_radius = texture(position_tex, behindBorder_pos_screen);
							tube_radius = uintBitsToFloat(nextGlpyh_pos_radius.w);

							center_frame_center_tube = texture(glyph_center_tex, center_frame_pos_screen).xyz;
							//center_frame_center_tube = center_frame_pos_tube - normalize(get_inverse_normal_matrix() * center_frame_normal_eye) * tube_radius;
							//glyph_pos_eye = (get_modelview_matrix() * vec4(center_frame_center_tube, 1.0)).xyz;

							//vec3 nextGlpyh_pos_eye = vec3(uintBitsToFloat(nextGlpyh_pos_radius.x), uintBitsToFloat(nextGlpyh_pos_radius.y), uintBitsToFloat(nextGlpyh_pos_radius.z));

							ray_dir_glyph = normalize(get_inverse_normal_matrix() * pos_eye);
							ray_pos_glyph = pos_tube - center_frame_center_tube;

							rmr.isNext = true;
							glyph = nextGlyph;
						}
						else
						{
							int prevGlyphID = closest.id - 1 == -1 ? closest.id : closest.id - 1;
							glyph_desc0 prevGlyph = glyphs0[prevGlyphID];

							float ds = glyph.s - prevGlyph.s;
							vec3 behindBorder_pos_tube = center_frame_pos_tube - ds * 1.01 * tangent_tube;
							vec3 behindBorder_pos_eye = (get_modelview_matrix() * vec4(behindBorder_pos_tube, 1.0)).xyz;
							vec4 behindBorder_pos_clip = get_projection_matrix() * vec4(behindBorder_pos_eye, 1.0);
							vec3 behindBorder_pos_ndc = behindBorder_pos_clip.xyz / behindBorder_pos_clip.w;
							vec2 behindBorder_pos_screen = vec2((behindBorder_pos_ndc.x + 1.0) / 2.0 , (behindBorder_pos_ndc.y + 1.0) / 2.0);							

							vec3 prevGlpyh_tangent_eye = texture(tangent_tex, behindBorder_pos_screen).xyz;
							vec3 prevGlyph_tangent_tube = normalize(get_inverse_normal_matrix() * prevGlpyh_tangent_eye);

							//take 50%s in tangent direction of actual glyph to get to border, then 0.5*s in tangent direction of next glyph to get to center of next glyph
							center_frame_pos_tube = center_frame_pos_tube - 0.5*ds*tangent_tube - 0.5*ds*prevGlyph_tangent_tube;
							
							//Do the same as before, just now for the center of the next glyph
							center_frame_pos_eye = (get_modelview_matrix() * vec4(center_frame_pos_tube, 1.0)).xyz;
							center_frame_pos_clip = get_projection_matrix() * vec4(center_frame_pos_eye, 1.0);
							center_frame_pos_ndc = center_frame_pos_clip.xyz / center_frame_pos_clip.w;
							center_frame_pos_screen = vec2((center_frame_pos_ndc.x + 1.0) / 2.0 , (center_frame_pos_ndc.y + 1.0) / 2.0);

							center_frame_normal_eye = texture(normal_tex, center_frame_pos_screen).rgb;

							center_frame_albedo = texture(albedo_tex, center_frame_pos_screen);
							center_frame_hit_segment_id = int(center_frame_albedo.w);

							uvec4 nextGlpyh_pos_radius = texture(position_tex, behindBorder_pos_screen);
							tube_radius = uintBitsToFloat(nextGlpyh_pos_radius.w);

							center_frame_center_tube = texture(glyph_center_tex, center_frame_pos_screen).xyz;

							//center_frame_center_tube = center_frame_pos_tube - normalize(get_inverse_normal_matrix() * center_frame_normal_eye) * tube_radius;
							//glyph_pos_eye = (get_modelview_matrix() * vec4(center_frame_center_tube, 1.0)).xyz;

							//vec3 nextGlpyh_pos_eye = vec3(uintBitsToFloat(nextGlpyh_pos_radius.x), uintBitsToFloat(nextGlpyh_pos_radius.y), uintBitsToFloat(nextGlpyh_pos_radius.z));

							ray_dir_glyph = normalize(get_inverse_normal_matrix() * pos_eye);
							ray_pos_glyph = pos_tube - center_frame_center_tube;

							rmr.isPrev = true;
							glyph = prevGlyph;
							rmr.debug_color = vec3(rmr.debug_color.x, 1.0, 0.0);
						}
					}
					i = 0;
					//Check if screen pixel lies on tube surface and if its the same or neighbouring segment ID
					if(center_frame_normal_eye != vec3(0.0) && abs(center_frame_hit_segment_id-segment_id) <= 1 )
					{
						while(i < glyph_rm.max_iterations)
						{
							dist = GLYPH_SDF_DEFINITION;
							if(dist < glyph_rm.hit_epsilon)
							{
								rmr.pos_eye = (get_modelview_matrix() * vec4(ray_pos_glyph + center_frame_center_tube, 1.0)).xyz;
								rmr.hit = true;
								break;
							}
							ray_pos_glyph = ray_pos_glyph + ray_dir_glyph * dist;
							i++;
						}
					}
					if(rmr.hit)
					{
						const float normal_calc_delta = 0.1;
						vec3 hit_pos_plus = ray_pos_glyph + normal_calc_delta;
						vec3 hit_pos_minus = ray_pos_glyph - normal_calc_delta;
						rmr.normal_eye = normalize(get_normal_matrix() * GLYPH_SURFACE_GRAD_DEFINITION);
						normal_eye = rmr.normal_eye;
					}
					//rmr.debug_color = glyph_center_tube;
				}
		#endif

				float non_outline_factor = 1;
				L0_GLYPH_DEFINITION
				
				specular_factor = non_outline_factor*0.25;
				
			}
		}
#endif
		// glyph layer 1
#if L1_VISIBLE > 0 && L1_MAPPED_ATTRIB_COUNT > 0
		{
			closest_glyphs_info closest;
			vec2 glyphuv = uv;
			if (get_closest_samples1(segment_id, glyphuv.s, closest)) {
				glyph_desc1 glyph = glyphs1[closest.id];

				glyphuv = vec2(
					(closest.dp <= closest.dn ? closest.dp : -closest.dn)
					* length_scale, // <-- ToDo: replace with automatic uv re-projection method
					glyphuv.t
				);

				float non_outline_factor = 1;
				L1_GLYPH_DEFINITION
				specular_factor = specular_factor > 0 ? non_outline_factor*0.25 : specular_factor;
			}
		}
#endif
		// glyph layer 2
#if L2_VISIBLE > 0 && L2_MAPPED_ATTRIB_COUNT > 0
		{
			closest_glyphs_info closest;
			vec2 glyphuv = uv;
			if (get_closest_samples2(segment_id, glyphuv.s, closest)) {
				glyph_desc2 glyph = glyphs2[closest.id];

				glyphuv = vec2(
					(closest.dp <= closest.dn ? closest.dp : -closest.dn)
					* length_scale, // <-- ToDo: replace with automatic uv re-projection method
					glyphuv.t
				);

				float non_outline_factor = 1;
				L2_GLYPH_DEFINITION
				specular_factor = specular_factor > 0 ? non_outline_factor*0.25 : specular_factor;
			}
		}
#endif
		// glyph layer 3
#if L3_VISIBLE > 0 && L3_MAPPED_ATTRIB_COUNT > 0
		{
			closest_glyphs_info closest;
			vec2 glyphuv = uv;
			if (get_closest_samples3(segment_id, glyphuv.s, closest)) {
				glyph_desc3 glyph = glyphs3[closest.id];

				glyphuv = vec2(
					(closest.dp <= closest.dn ? closest.dp : -closest.dn)
					* length_scale, // <-- ToDo: replace with automatic uv re-projection method
					glyphuv.t
				);

				float non_outline_factor = 1;
				L3_GLYPH_DEFINITION
				specular_factor = specular_factor > 0 ? non_outline_factor*0.25 : specular_factor;
			}
		}
#endif

		// enable to highlight segments with a glyph count greater than given value
		//if(ranges0[segment_id].n > 2)
		//color = vec3(1.0, 0.0, 0.0);
		
#if DEBUG_SEGMENTS == 1
		// highlight individual segments
		if((segment_id&1) > 0) color *= 0.5;
#endif

#if GRID_MODE & 1
		color = mix(color, grid_color.rgb, compute_grid_factor(uv) * grid_color.a);
#endif

		subp_color = compute_reflected_appearance(pos_eye, normal_eye, vec4(color, 1.0), 1, specular_factor);

#if GRID_MODE & 2
		vec3 gn = compute_grid_normal(uv);
		vec3 bitangent_eye = cross(normal_eye, tangent_eye);
		mat3 TBN = mat3(tangent_eye, bitangent_eye, normal_eye);
		vec3 normal_eye_bump = mix(normal_eye, normalize(TBN * gn), normal_mapping_scale);
		vec4 subp_color_bump = compute_reflected_appearance(pos_eye, normal_eye_bump, vec4(color, 1.0), 1, specular_factor);
		//color = 0.5*gn+0.5;
		float aa_factor = min(aa_texture(grids[0].scaling*uv, grids[0].thickness, 0.5) + aa_texture(grids[1].scaling*uv, grids[1].thickness, 0.5), 1);
		subp_color = mix(subp_color, subp_color_bump, aa_factor);
#endif

		//if(ambient_occlusion.enable)
#if ENABLE_AMBIENT_OCCLUSION == 1
		subp_color.rgb *= compute_ambient_occlusion_factor(pos_eye, normal_eye);
#endif

		// Debug outputs:
		//subp_color = vec4((pos_eye + 5.0)/10.0, 1.0); // position (adjusted for HotRoom)
		//subp_color = vec4(0.5*normal_eye + 0.5, 1.0); // normal
		//subp_color = vec4(0.5*tangent_eye + 0.5, 1.0); // tangent
		//subp_color = vec4(vec3(depth), 1.0); // tangent
		//subp_color = vec4(0.1*texcoord.x, texcoord.y, 0.0, 1.0); // texcoords
		//subp_color = vec4(hash31(segment_id), 1.0); // segment_id
	}

	subp_color.rgb = pow(subp_color.rgb, 1.0/gamma3);

	// write colorchannel corresponding to this subpixel
	if (holographic_raycast)
		frag_color[subp] = subp_color[subp];
	else
		frag_color = subp_color;

	// update fragment depth if this subpixel's depth is smaller
	frag_depth = depth < frag_depth ? depth : frag_depth;

	}
	// END - holography loop
	/////////////////////////////////////////////
	
	// write the frag depth to enable the framework view to work properly
	gl_FragDepth = frag_depth;
}
