#version 430

#define RM_EPSILON 0.00005
#define RM_MAX_ITERATIONS 30
#define RM_FDG_DELTA 0.001


struct sphere_splat_info
{
	vec2 q_tilde;
	vec3 inv_T_square_v;
	vec3 inv_T_square_e_c;
	float inv_e;
	vec2 e_zw_clip;
	vec2 v_zw_clip;
	vec3 v_eye;
};

in sphere_splat_info ssi;

in SPHERE_FS {
	vec4  color;
	float percentual_blend_width;
	float percentual_point_size;
	float percentual_core_size;
	float percentual_splat_size;
} fi;

in Sphere_RMF {
	vec4 pos_radius;
}srmf;

uniform float morph_sin_factor = 20.0;
uniform int culling_mode = 0;

layout (binding = 0) uniform sampler2D color_maps_tex;
uniform vec4 glyph_cc_param = vec4(0.0, 1.0, 0.0, 1.0);

layout(location = 1) out vec4 frag_position;
layout(location = 2) out vec3 frag_normal;


//***** begin interface of view.glsl ***********************************
mat4 get_modelview_matrix();
mat4 get_projection_matrix();
mat4 get_modelview_projection_matrix();
mat4 get_inverse_modelview_matrix();
mat4 get_inverse_modelview_projection_matrix();
mat3 get_normal_matrix();
mat3 get_inverse_normal_matrix();
//***** end interface of view.glsl ***********************************

// clamp value v to range [r.x,r.y] and remap to [r.z,r.w]
float clamp_remap(float v, vec4 r) {
	v = clamp(v, r.x, r.y);
	float t = 0.0;
	if(abs(r.x - r.y) > 0.00001)
		t = (v - r.x) / (r.y - r.x);
	return mix(r.z, r.w, t);
}

vec3 map_to_color(float v, int color_map_idx) {
	vec2 ts = textureSize(color_maps_tex, 0);
	float half_step = 0.5 * (1.0 / ts.y);
	float map_coord = float(color_map_idx) / ts.y + half_step;
	return pow(texture(color_maps_tex, vec2(v, map_coord)).rgb, vec3(2.2));
}

//***** copied and modified from interface of sphere_lib.glfs ***********************************
bool compute_ray_sphere_intersection(in float percentual_splat_size, out vec3 p_eye, out vec3 n_eye, out vec2 splat_tc, out int side, out float lambda)
{
	// ray-sphere intersection	

	// check for intersection with q_tilde parameterization of unit circle
	float q_tilde_squared_length = dot(ssi.q_tilde.xy, ssi.q_tilde.xy);
	float percentual_radial_position = sqrt(q_tilde_squared_length);
	if (percentual_radial_position > percentual_splat_size)
		return false;
	if (q_tilde_squared_length > 1.0)
		q_tilde_squared_length = 1.0;

	splat_tc = 0.5*(ssi.q_tilde + vec2(1.0));
	// compute ray parameter of intersection
	float beta = ssi.inv_e*sqrt(1.0 - q_tilde_squared_length);
	lambda = 1.0 / (1.0 + beta);

	// culling 

	// compute sphere position in eye coordinates and normal
	p_eye = lambda * ssi.v_eye;
	n_eye = normalize(ssi.inv_T_square_e_c + lambda * ssi.inv_T_square_v);
	
	side = (dot(n_eye, p_eye) < 0.0) ? 1 : 0;
	bool keep_this_side = (culling_mode == 0) || (side != culling_mode-1); 
	if (!keep_this_side) {
		lambda = 1.0 / (1.0 - beta);
		p_eye = lambda * ssi.v_eye;
		n_eye = normalize(ssi.inv_T_square_e_c + lambda * ssi.inv_T_square_v);
	}

	return true;
}
//***** end interface of sphere_lib.glfs ***********************************



//***** begin instead of ray-cast intersection between ray-sphere, use ray marching using sphere_sd ***********************************
float sd_sphere(in vec3 ray_pos_glyph, in float glyph_scale, in float radius)
{
	return length(ray_pos_glyph) - (radius * glyph_scale);
}

vec3 normal_sphere(in vec3 hit_pos_glyph)
{
	return normalize(hit_pos_glyph);
}

// from https://iquilezles.org/articles/distfunctions/
float morph_sin(in vec3 glyph_pos, in vec3 pos, in float bounding_dist, in float factor)
{	
	vec3 v_seed = glyph_pos + pos;
	return factor == 0.0 ? 0.0 :  0.1 * bounding_dist * (1.0 + sin(factor*v_seed.x)*sin(factor*v_seed.y)*sin(factor*v_seed.z)) * 0.5;
}

//Hardcoded for now
vec3 normal_fdg_for_morph_sin(in vec3 glyph_pos, in vec3 pos, in float bounding_dist, in float factor)
{	
	vec3 hit_pos_plus = pos + RM_FDG_DELTA;
	vec3 hit_pos_minus = pos - RM_FDG_DELTA;
	
	float dx = sd_sphere(vec3(hit_pos_plus.x, pos.yz), 1.0, srmf.pos_radius.w) + morph_sin(glyph_pos, vec3(hit_pos_plus.x, pos.yz), bounding_dist, factor) - sd_sphere(vec3(hit_pos_minus.x, pos.yz), 1.0, srmf.pos_radius.w) + morph_sin(glyph_pos, vec3(hit_pos_minus.x, pos.yz), bounding_dist, factor);
	float dy = sd_sphere(vec3(pos.x, hit_pos_plus.y, pos.z), 1.0, srmf.pos_radius.w) + morph_sin(glyph_pos, vec3(pos.x, hit_pos_plus.y, pos.z), bounding_dist, factor) - sd_sphere(vec3(pos.x, hit_pos_minus.y, pos.z), 1.0, srmf.pos_radius.w) + morph_sin(glyph_pos, vec3(pos.x, hit_pos_minus.y, pos.z), bounding_dist, factor);
	float dz = sd_sphere(vec3(pos.xy, hit_pos_plus.z), 1.0, srmf.pos_radius.w) + morph_sin(glyph_pos, vec3(pos.xy, hit_pos_plus.z), bounding_dist, factor) - sd_sphere(vec3(pos.xy, hit_pos_minus.z), 1.0, srmf.pos_radius.w) + morph_sin(glyph_pos, vec3(pos.xy, hit_pos_minus.z), bounding_dist, factor);

	return normalize(vec3(dx, dy, dz));
}

vec3 ray_march(in out vec3 pos_eye, in out vec3 normal_eye, in out vec2 splat_tc, out int side)
{	
	float lambda;
	
	// use the established ray-sphere intersetion test to see if the ray hits the bounding sphere -> if hit, we perform ray-marching to enable morphing and compositing
	if (!compute_ray_sphere_intersection(fi.percentual_splat_size, pos_eye, normal_eye, splat_tc, side, lambda))
		discard;
	
	
	vec3 glyph_position_world = srmf.pos_radius.xyz;
	vec3 pos_glyph = (get_inverse_modelview_matrix() * vec4(pos_eye, 1.0)).xyz - glyph_position_world;
	// bounding_dist is the distance from the glyph center to the bounding shape at the hit position -> used to enforce sub-surface morphing
	float bounding_dist = length(pos_glyph);
	vec3 dir_world = normalize(get_inverse_normal_matrix() * pos_eye);


	int i = 0;
	//Dist is 0 at the beginning, because we start at the general sphere surface coming form the ray cast result.
	float dist = 0.0;
	while(i < RM_MAX_ITERATIONS)
	{
		dist = sd_sphere(pos_glyph, 1.0, srmf.pos_radius.w) + morph_sin(glyph_position_world, pos_glyph, bounding_dist, morph_sin_factor);
		lambda += dist;
		// we hit -> calculate normal using finite difference gradient
		if(abs(dist) <= RM_EPSILON)
		{
			pos_eye = (get_modelview_matrix() * vec4(pos_glyph + glyph_position_world, 1.0)).xyz;
			
			vec3 normal_glyph = normal_sphere(pos_glyph) + normal_fdg_for_morph_sin(glyph_position_world, pos_glyph, bounding_dist, morph_sin_factor);
			normal_eye = normalize(get_normal_matrix() * normal_glyph);

			return map_to_color(clamp_remap(fi.color.x, glyph_cc_param), int(fi.color.y));
			//return fi.color.xyz;
		}

		pos_glyph += dir_world * dist;
		i++;
	}

	discard;
	return vec3(1.0, 0.0, 0.0);
}
//***** end instead of ray-cast intersection between ray-sphere, use ray marching using sphere_sd ***********************************


//***** begin interface of surface.glsl ***********************************
struct Material {
	int brdf_type;
	vec3 diffuse_reflectance;
	float roughness;
	float metalness;
	float ambient_occlusion;
	vec3 emission;
	float transparency;
	vec2 propagation_slow_down;
	float roughness_anisotropy;
	float roughness_orientation;
	vec3 specular_reflectance;
};

vec4 compute_reflected_radiance(in Material M, vec3 position_eye, vec3 normal_eye);
vec4 compute_reflected_appearance(vec3 position_eye, vec3 normal_eye, vec4 color_fs, int side);
vec4 compute_reflected_appearance_texture(vec3 position_eye, vec3 normal_eye, vec2 texcoords, vec4 color_fs, int side);
//***** end interface of surface.glsl ***********************************

//***** begin interface of fragment.glfs ***********************************
uniform float gamma = 2.2;
void finish_fragment(vec4 color);
void finish_fragment(vec4 color, float depth);
//***** end interface of fragment.glfs ***********************************

void main()
{
	vec3 p_eye;
	vec3 n_eye;
	int side;
	vec2 tc;
	vec4 glyph_color = vec4(ray_march(p_eye, n_eye, tc, side), 1.0);

	vec4 v_eye = vec4(p_eye, 1.0);
	vec4 v_depth = get_projection_matrix() * v_eye;
	float depth = 0.5*(v_depth.z / v_depth.w) + 0.5;
	

	vec4 color = compute_reflected_appearance(p_eye, n_eye, glyph_color, side);
	finish_fragment(color, depth);
	frag_position = vec4(p_eye, 1.0);
	frag_normal = n_eye;
}